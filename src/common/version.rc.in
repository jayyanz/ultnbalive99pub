/* Version resource template; build.sh fills in the @...@ fields per binary. */
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @MAJ@, @MIN@, @PAT@, 0
PRODUCTVERSION  @MAJ@, @MIN@, @PAT@, 0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       @DEBUGFLAG@
FILEOS          VOS_NT_WINDOWS32
FILETYPE        @TYPE@
FILESUBTYPE     0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "0c0904b0"
        BEGIN
            VALUE "CompanyName",      "NBA Live 99 community fix"
            VALUE "FileDescription",  "@DESC@"
            VALUE "FileVersion",      "@LINE@"
            VALUE "InternalName",     "@NAME@"
            VALUE "OriginalFilename", "@NAME@"
            VALUE "ProductName",      "NBA Live 99 fix"
            VALUE "ProductVersion",   "@LINE@"
            VALUE "Build",            "@BUILD@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0c09, 1200
    END
END
